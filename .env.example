# Portas publicadas no host pelo Podman Compose.
API_PORT=8000
FLAGD_PORT=8013
FLAGD_MANAGEMENT_PORT=8014
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
MLFLOW_PORT=5000
AIRFLOW_PORT=8080
MLFLOW_SERVER_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[[]::1]:*,mlflow,mlflow:*
MLFLOW_SERVER_WORKERS=1

# Somente para a UI local vinculada a 127.0.0.1; use false se quiser login.
AIRFLOW_LOCAL_ALL_ADMINS=true

# Troque a senha antes de compartilhar o ambiente fora da máquina local.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=datathon-local

DEPLOYMENT_ENVIRONMENT=local-compose
DATATHON_POLICY_MODE=approved

# Simulador de CRM. As senhas abaixo são apenas padrões de desenvolvimento local.
CRM_API_PORT=8081
CRM_WEB_PORT=80
CRM_WEB_ORIGIN=http://localhost
CRM_DATABASE_PORT=5433
CRM_DATABASE_NAME=crm
CRM_DATABASE_PASSWORD=crm_local_password
CRM_DATABASE_OWNER_PASSWORD=crm_owner_local_password
