# Portas publicadas no host pelo Podman Compose.
API_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
MLFLOW_PORT=5000

# Troque a senha antes de compartilhar o ambiente fora da máquina local.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=datathon-local

DEPLOYMENT_ENVIRONMENT=local-compose
DATATHON_POLICY_MODE=approved
